# 이 파일을 복사해서 같은 위치에 ".env" 로 저장하고 실제 키 값을 채운다.
# .env 파일은 git에 올리지 않는다 (.gitignore 처리됨) — 서버에 직접 생성해야 한다.
#
# secom-allowance-calculator/project/.env 에 있는 값과 동일하게 넣으면 된다.

NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_LOCAL_CLIENT_ID=
NAVER_LOCAL_CLIENT_SECRET=
OPINET_API_KEY=

# 하이웍스 API (docs/hiworks-api-setup.md). 오피스 토큰은 관리자가 발급 — 값은 채팅·이슈·메일에 적지 않는다.
HIWORKS_OFFICE_TOKEN=
HIWORKS_DOMAIN=
# 첫 HR 담당자의 하이웍스 사용자 번호 (로그인 설계 §4). 활성 HR이 0명일 때만 쓴다 — 개발본부장 쪽이 넣는다 (가이드 8장)
HIWORKS_FIRST_HR_USER_NO=
# 1 이면 사번 + 이름으로 첫 연결 (로그인 설계 §4 대안). 6단계 실연결에서 번호 체계가 다를 때만 켠다
HIWORKS_SSO_LINK_BY_EMPLOYEE_NO=
# HIWORKS_LINK_API_BASE 는 PC 시험용(가짜 확인 서버)이다. 서버 .env 에 넣으면 api 가 뜨지 않는다 (§7)
# 결재 양식 아이디: 결재 종류마다 HIWORKS_FORM_ID_<종류> 한 줄씩, 해당 구현 PR에서 추가 (가이드 4장 "결재 양식 아이디 이름 규칙")
# 급여명세서 · 원천징수영수증 · 연봉계약서 잠금 열쇠 (backend/payslip.py · withholding.py · contract.py 가 같은 열쇠를 쓴다). 서버에서 한 번 만든다 — 32바이트 무작위 값을 base64 로:
#   python3 -c "import base64,secrets;print(base64.b64encode(secrets.token_bytes(32)).decode())"
# 잃으면 저장된 명세서 · 영수증 · 연봉계약서를 못 연다 — 명세서 · 영수증은 NAS 원본으로 다시 올리면 되지만, 서명한 연봉계약서(서명 그림 · 서명본 PDF)는 서버에만 있어 다시 올릴 수 없다.
# 열쇠는 DB 백업과 같은 곳에 두지 않고(백업이 새도 못 풀게), 열쇠 자체를 따로 백업해 둔다. 값은 채팅·이슈·메일에 적지 않는다.
HR_PAY_KEY=

# 휴대폰 알림(웹 푸시) 열쇠 한 쌍 — backend/push.py. 서버에서 한 번 만들어 두 줄을 붙인다 (값은 비워 둔 채로 올린다):
#   docker compose exec -T api python -m push keygen
# 공개키는 휴대폰에 알려 주는 값, 개인키는 서버만 아는 값이다. 개인키는 채팅·이슈·메일에 적지 않는다.
# 비워 두거나 모양이 틀리면 알림 보내기만 조용히 건너뛰고 다른 기능은 그대로 된다. 열쇠를 바꾸면 휴대폰마다 알림을 다시 켜야 한다.
HR_PUSH_PUBLIC=
HR_PUSH_PRIVATE=
